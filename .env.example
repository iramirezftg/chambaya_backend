# ==============================================================================
# Almacenamiento en la Nube (Evidencias de Trabajo, Tickets y KYC)
# ==============================================================================
# Opción 1: Cloudinary (Recomendado - 25 GB gratis, sin tarjeta)
# Puedes usar CLOUDINARY_URL o las 3 variables separadas:
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# CLOUDINARY_CLOUD_NAME="chambaya"
# CLOUDINARY_API_KEY="123456789012345"
# CLOUDINARY_API_SECRET="your_secret_key"

# Opción 2: AWS S3 / Cloudflare R2 / Supabase Storage
# AWS_S3_BUCKET="chambaya-uploads"
# AWS_ACCESS_KEY_ID="your_access_key"
# AWS_SECRET_ACCESS_KEY="your_secret_key"
# AWS_REGION="us-east-1"
# AWS_ENDPOINT="https://[id].r2.cloudflarestorage.com" # (Solo si usas Cloudflare R2 o Supabase)
# S3_PUBLIC_URL="https://pub-xxxx.r2.dev"
